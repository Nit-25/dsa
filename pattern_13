class Solution:
    def pattern22(self, n):
        for i in range(1, n+1):
            # Left
            for j in range(i):
                print(j+1, end = " ")

            # Middle
            for k in range(n*2 - (i*2)):
                print(" ", end = " ")

            #Right
            for l in range(i):
                print(i-l, end = " ")
            print()
            
            
            
