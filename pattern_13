class Solution:
    def pattern12(self, n):
        for i in range(n):
            for j in range(n*2):
                if j <= i:
                    print(j+1, end ="")
                elif j >= (n*2 - 1) - i:
                    print((n*2-(j+1)) + 1, end="")
                else:
                    
                    #     print(j+1, end = "")
                    print(" ", end="")
            print()

