ass Solution:
    def pattern17(self, n):
        for i in range(n, 0, -1):
            for j in range(i-1):
                print(" ", end = " ")
            for k in range(0, n-(i-1)):
                print(chr(ord('A') + k), end=" ")
            for l in range(k):
                print(chr(ord('A') + k-(l+1)), end = " ")
            print()
            
obj = Solution()
obj.pattern17(5)


class Solution:
    def pattern22(self, n):
        for i in range(n):
            for j in range(n, i+1, -1):
                print(" ", end = " ")
            for k in range(i*2 + 1):
                alpha = min(k, 2*i - k)
                print(chr(ord("A") + alpha), end = " ")
            print()

            

obj = Solution()
obj.pattern22(4)


