class Solution:
    def pattern13(self, n):
        prev = 0
        for i in range(1, n+1):
            c = 0
            for j in range(i):
                print(i+j+prev, end=" ")
                c += j
            prev = c
            print()


class Solution:
    def pattern22(self, n):
        num = 0
        for i in range(n):
            for j in range(i+1):
                num+=1
                print(num, end = " ")
            print()
            
            
