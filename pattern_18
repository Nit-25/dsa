class Solution:
    def pattern18(self, n):
        for i in range(n, 0, -1):
            for j in range(n, i-1, -1):
                print(chr(ord('A') + (i-1) + (n-j)), end = " ")
            print()
            
obj = Solution()
obj.pattern18(4)

class Solution:
    def pattern22(self, n):
        for i in range(1, n+1):
            for j in range(i, 0, -1):
                print(chr(ord('A') + n-j), end = " ")
            print()
            

obj = Solution()
obj.pattern22(4)

