class Solution:
    def pattern19(self, n):
        for i in range(n):
            for j in range(n, i, -1):
                print("*", end=" ")
            for k in range(i*2):
                print(" ", end = " ")
            for l in range(i, n):
                print("*", end = " ")
            print()
        for p in range(n):
            for q in range(p+1):
                print("*", end=" ")
            for r in range(n*2-2, p*2, -1):
                print(" ", end = " ")
            for s in range(n*2-(p+1), n*2):
                print("*", end = " ")
            print()
            
obj = Solution()
obj.pattern19(4)


